# Keep your existing backend environment values and add these on Render.
GOOGLE_PLAY_PACKAGE_NAME=com.flexiwalls.app
GOOGLE_PLAY_MONTHLY_PRODUCT_ID=flexiwalls_premium_monthly
GOOGLE_PLAY_YEARLY_PRODUCT_ID=flexiwalls_premium_yearly
GOOGLE_PLAY_LIFETIME_PRODUCT_ID=flexiwalls_premium_lifetime

# Recommended for Render: base64 encode the complete service-account JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=PASTE_BASE64_SERVICE_ACCOUNT_JSON_HERE

# Alternative (one-line JSON; do not set both):
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
